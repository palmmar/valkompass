# Kopiera till .env och justera vid behov.

# --- Backend (ASP.NET Core) ---
# Anslutningssträng till Postgres (matchar docker-compose.yml).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=valkompass;Username=valkompass;Password=valkompass

# Bootstrap-admin som seedas vid uppstart (skapas bara om den inte redan finns).
ADMIN_EMAIL=admin@valkompass.local
ADMIN_PASSWORD=Andra-detta-1!

# Tillåten frontend-origin för CORS (cookie-baserad admin-auth kräver explicit origin).
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---
# I dev proxas /api/* till backend via next.config.ts (rewrites), så denna kan vara tom.
# Sätt absolut URL om frontend ska anropa API:t direkt (utan proxy).
NEXT_PUBLIC_API_BASE_URL=
# Bas-URL för backend som Next.js rewrites/Server Components använder (server-side).
BACKEND_URL=http://localhost:5208
